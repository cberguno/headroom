# Model provider: "anthropic" or "openai" (any OpenAI-compatible endpoint)
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5-5
MODEL_MAX_OUTPUT_TOKENS=4096

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# For MODEL_PROVIDER=openai (OpenAI, Ollama at http://localhost:11434/v1, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and MODEL_NAME=<provider/model id>

# Limits
MAX_DEPTH=3
MAX_TURNS=20
MAX_TOTAL_TOKENS=200000

# Paths and sandbox
WORKSPACE_DIR=./workspace
HISTORY_DIR=./.history
# The default image has no Python. Use python:3.12-alpine if the agent runs Python.
SHELL_IMAGE=python:3.12-alpine
SHELL_TIMEOUT_MS=30000
SHELL_NETWORK=none
