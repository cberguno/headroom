# Alpaca PAPER trading keys only — get them from
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay the paper endpoint. broker.py refuses to run otherwise.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# At least one of these, matching TRADER_LLM_MODEL below (via litellm).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any litellm model id, e.g. gpt-4o-mini, claude-3-5-sonnet-latest, gemini/gemini-1.5-pro
TRADER_LLM_MODEL=gpt-4o-mini

# Comma-separated symbols the agent is allowed to trade.
TRADER_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA
# Symbol the fitness function compares total return against.
TRADER_BENCHMARK=SPY
# Starting cash used only for offline backtests (self_improve.py).
TRADER_STARTING_CASH=100000

# Hard risk limits enforced in code regardless of what the agent proposes.
TRADER_MAX_POSITION_PCT=0.2
TRADER_MAX_ORDERS_PER_STEP=3
TRADER_ALLOW_SHORT=false
