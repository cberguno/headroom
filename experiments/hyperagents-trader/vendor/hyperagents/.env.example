# Copy to .env in this directory (vendor/hyperagents/). Never commit the
# real .env -- it's already covered by this repo's .gitignore.

# For the task agent's decisions (backtesting) and, if you run generate_loop.py,
# the meta-agent's patch proposals. At least one of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Any OTHER OpenAI-compatible provider (Nous Portal, OpenRouter, Together, a
# local vLLM server, etc.) also goes through OPENAI_API_KEY, plus this to
# redirect where "openai/..." model requests actually go -- agent/llm.py only
# ever passes a bare model string to litellm, never a custom api_base, so this
# env var is the only hook. Verified working against Nous's Portal
# (https://inference-api.nousresearch.com/v1): set OPENAI_API_KEY to the
# provider's key, OPENAI_API_BASE below, and TRADER_LLM_MODEL to
# "openai/<catalog id exactly as that provider's GET /v1/models lists it>"
# -- e.g. "openai/inclusionai/ling-3.0-flash-sante:free" (a real, verified,
# zero-cost model on Nous Portal as of this writing; call GET {base}/models
# with your key to see what's currently offered, since catalogs change).
# OPENAI_API_BASE=https://inference-api.nousresearch.com/v1

# Only needed for domains/alpaca_trading/run_live_episode.py -- get PAPER
# (not live) keys from https://app.alpaca.markets/paper/dashboard/overview.
# Backtesting and self-improvement never read these.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave as the paper endpoint -- domains/alpaca_trading/broker.py refuses to
# run against anything else.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Any litellm model id. Default gpt-4o-mini keeps per-generation backtest
# cost down -- see domains/alpaca_trading/README.md's cost-math section.
# For Gemini (Google AI Studio) keys, litellm needs the "gemini/" prefix,
# e.g. TRADER_LLM_MODEL=gemini/gemini-3-flash-preview -- verified working
# against a real key; free-tier quota for preview models can be as low as
# 20 requests/day, easy to exhaust with a single multi-day backtest.
TRADER_LLM_MODEL=gpt-4o-mini
