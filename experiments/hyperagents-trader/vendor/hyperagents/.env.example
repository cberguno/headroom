# Copy to .env in this directory (vendor/hyperagents/). Never commit the
# real .env -- it's already covered by this repo's .gitignore.

# For the task agent's decisions (backtesting) and, if you run generate_loop.py,
# the meta-agent's patch proposals. At least one of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Only needed for domains/alpaca_trading/run_live_episode.py -- get PAPER
# (not live) keys from https://app.alpaca.markets/paper/dashboard/overview.
# Backtesting and self-improvement never read these.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave as the paper endpoint -- domains/alpaca_trading/broker.py refuses to
# run against anything else.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Any litellm model id. Default gpt-4o-mini keeps per-generation backtest
# cost down -- see domains/alpaca_trading/README.md's cost-math section.
TRADER_LLM_MODEL=gpt-4o-mini
